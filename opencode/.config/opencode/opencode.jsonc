{
  "$schema": "https://opencode.ai/config.json",
    "mcp": {
    "quickshell-mcp": {
      "type": "local",
      "command": ["uvx", "quickshell-mcp"],
      "enabled": true
    },
    "duckduckgo-search": {
      "type": "local",
      "command": ["uvx", "duckduckgo-mcp-server"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true
    },
    "puppeteer": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-puppeteer"],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": ["uvx", "mcp-server-fetch"],
      "enabled": true
    }
    }
}
