{
  "layer": "bottom",
  "position": "top",
  "height": 40,
  "spacing": 0,
  "margin": "15 15 0 15",
  //"margin": "0",
  "modules-left": ["niri/workspaces", "custom/prev", "custom/next", "custom/player"],
  "modules-center": ["cpu", "clock", "memory"],
  "modules-right": ["custom/weather", "network", "backlight", "pulseaudio", "battery", "niri/language", "tray", "custom/powermenu"],

  /* Left */
  "niri/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "sort-by-number": true,
    "format-icons": {
      "1": "",
      "2": "󰈹",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "default": ""
    },
     "persistent-workspaces": {
       "*": 6
     }
  },


  "custom/player": {
    "format": "{}",
    "interval": 1,
    "exec": "~/.bin/getPlayer",
    "max-length": 50,
    "ellipsis": "...",
    "on-click": "playerctl play-pause",
    "tooltip": false
  },

  "custom/prev": {
    "format": "󰒮",
    "on-click": "playerctl previous",
    "tooltip": false
  },
  "custom/next": {
    "format": "󰒭",
    "on-click": "playerctl next",
    "tooltip": false
  },


  "custom/weather": {
    "format": "    {}",
    "interval": 60,
    // "exec": "cat /tmp/weather.txt",
    "exec": "$HOME/.bin/getWeather",
    // "exec-if": "test -f /tmp/weather.txt",
    "on-click": "~/.bin/getWeather"
  },

  /* Center */
  "cpu": {
    "format": " {usage}%",
    "tooltip": false,
    "interval": 1
  },
  "clock": {
    "format": "󰥔 {:%H:%M}",
    "format-alt": " {:%Y-%m-%d}",
    "on-click-right": "gsimplecal",
    "tooltip": false,
    "interval": 60
  },
  "memory": {
    "format": " {used:0.1f}GB",
    "tooltip": false,
    "interval": 1
  },

  /* Right */
  "custom/colorpicker": {
    "format": "",
    "tooltip": false,
    "on-click": "hyprpicker | wl-copy" 
  },
  "network": {
    "format-wifi": "{icon} {signalStrength}%",
    "format-linked": "󰒃",
    "format-icons": ["󰣾", "󰣴", "󰣶", "󰣸", "󰣺"],
    "format-disconnected": "󰣼", 
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "interval": 1
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃚 ", "󰃛 ", "󰃠 "],
    "tooltip": false,
    "tooltip-format": "{percent}%"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": [ "", " " ]
    },
    "tooltip-format": "{volume}%",
    "tooltip": false,
    "scroll-step": 1,
    "on-click": "pavucontrol"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip": false
  },
  "niri/language": {
    "format-en": "ᴇɴ",
    "format-ru": "ʀᴜ",
    "tooltip": false
  },
  "tray": {
    "icon-size": 20,
    "spacing": 5
  },
  "custom/powermenu": {
    "format": "⏻  ",
    "on-click": "$HOME/.bin/powerMenu",
    "tooltip": false
  }
}
