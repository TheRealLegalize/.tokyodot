// ============================================================================
// niri — конфиг, адаптированный из Hyprland (hyprtoolkit / Lua)
// Исходник: ~/.tokyodot/hyprland/.config/hypr  (референс-копия: ./hypr)
//
// Соответствие модулей Hyprland:
//   conf/env.lua          -> environment {} и cursor {}
//   conf/monitors.lua     -> output "eDP-1" {}
//   conf/input.lua        -> input {} (жесты тачпада — встроенные в niri)
//   conf/autostart.lua    -> spawn-*-at-startup
//   conf/looknfeel.lua    -> layout {}, blur {}, animations {}
//   conf/keybinds.lua     -> binds {} (Noctalia / Scripts / Programs / Windows / Workspaces / Media / Mouse)
//   conf/windowrules.lua  -> window-rule {}
//   colors/void-spectra.lua -> цвета бордера (#eb8700 = accent, #3b434d = inactive)
// ============================================================================

input {
  keyboard {
    xkb {
      // Hyprland: kb_layout "us,ru", kb_options = "grp:caps_toggle"
      layout "us,ru"
      options "grp:caps_toggle"
    }

    //numlock
  }

  touchpad {
    // Hyprland: tap_to_click, disable_while_typing, natural_scroll,
    //           clickfinger_behavior, scroll_factor 0.5
    tap
    dwt
    natural-scroll
    scroll-factor 0.5
    click-method "clickfinger"
  }

  mouse {
    // Hyprland: accel_profile = "adaptive", sensitivity = 0.2
    accel-speed 0.2
    // accel-profile "flat"
  }

  trackpoint {
    // off
    // natural-scroll
    // accel-speed 0.2
    // accel-profile "flat"
    // scroll-method "on-button-down"
    // scroll-button 273
    // scroll-button-lock
    // middle-emulation
  }

  // Hyprland: cursor.persistent_warps = true
  warp-mouse-to-focus

  // Hyprland: follow_mouse = 1
  focus-follows-mouse max-scroll-amount="1%"
}

// ---- Жесты тачпада ----------------------------------------------------------
// Hyprland (3 пальца): горизонтальный свайп -> смена рабочего стола,
//                      свайп вниз -> закрыть окно.
// В niri жесты встроены и не настраиваются:
//   3 пальца вверх/вниз    -> переключение рабочего стола
//   3 пальца влево/вправо  -> горизонтальное перемещение видов
//   4 пальца вверх         -> Overview

// ---- Окружение (conf/env.lua) ------------------------------------------------
environment {
  QT_QPA_PLATFORM "wayland"
  QT_QPA_PLATFORMTHEME "qt6ct"
  QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
  QT_AUTO_SCREEN_SCALE_FACTOR "1"
  GTK_USE_PORTAL "1"
  // XDG_CURRENT_DESKTOP niri выставляет сам.
  // XCURSOR_SIZE задаётся в блоке cursor ниже.
}

// Курсор (Hyprland autostart: hyprctl setcursor FrierenBLZ 36)
cursor {
  xcursor-theme "FrierenBLZ"
  xcursor-size 36
}

// ---- Монитор (conf/monitors.lua) ----------------------------------------------
output "eDP-1" {
  mode "2560x1440@60"
  scale 0.85
}

// ---- Раскладка / внешний вид (conf/looknfeel.lua) ------------------------------
layout {
  // Hyprland: gaps_out = 6, gaps_in = 2 (в niri единое значение)
  gaps 6

  center-focused-column "always"

  preset-column-widths {
    proportion 0.3
    proportion 0.5
    proportion 0.8
  }

  default-column-width { proportion 0.5; }

  // Кольцо фокуса не рисуем — как в Hyprland (только бордер)
  focus-ring {
    off
  }

  border {
    // Hyprland: border_size 2, active = accent (#eb8700), inactive = surface1 (#3b434d)
    width 2
    active-color "#eb8700"
    inactive-color "#3b434d"
    urgent-color "#9b0000"
  }

  // Hyprland: shadow.enabled = false
  shadow {
    off
    // Если захочется вернуть мягкую тень (как в старом niri-конфиге):
    // on
    // softness 30
    // spread 5
    // offset x=0 y=5
    // color "#0007"
  }
}

// ---- Размытие (Hyprland decoration.blur: size 3, passes 3, vibrancy 0.1696) ----
blur {
  passes 3
  offset 3
  noise 0.02
  saturation 1.17
}

// ---- Автозапуск (conf/autostart.lua) -------------------------------------------
spawn-sh-at-startup "wl-paste --type text --watch cliphist store"
spawn-sh-at-startup "wl-paste --type image --watch cliphist store"
spawn-sh-at-startup "LANG=ru_RU.UTF-8 noctalia --daemon"
spawn-sh-at-startup "gsr-ui launch-hide 2>&1 > /dev/null & gsr-notify --text 'Press Alt+Z to open the Shadowplay' --timeout 2 2>&1 > /dev/null &"

// Dropdown-терминал (Hyprland: [workspace special:dropdown silent] kitty --class dropdown-kitty)
spawn-at-startup "kitty" "--class" "dropdown-kitty"

// hyprctl setcursor / hyprpm / waybar / awww-daemon — только для Hyprland,
// в niri не нужны (курсор задан блоком cursor, бар берёт на себя noctalia).

hotkey-overlay {
  skip-at-startup
}
prefer-no-csd

screenshot-path "~/Screenshots/Screenshot-%Y-%m-%d %H-%M-%S.png"

// ---- Анимации (Hyprland: animations.enabled, окна popin, столы slidefade) ------
animations {
  workspace-switch {
    spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
  }

  window-open {
    duration-ms 150
    curve "ease-out-expo"
  }

  window-close {
    duration-ms 150
    curve "ease-out-quad"
  }

  horizontal-view-movement {
    spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
  }

  window-movement {
    spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
  }

  window-resize {
    spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
  }
}

// ---- Рабочие столы (Hyprland: workspace_rule persistent 1..6) -------------------
workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"
workspace "6"

// Аналог special:dropdown из Hyprland (переключение — F12)
// workspace "dropdown"

// ============================================================================
// Правила окон (conf/windowrules.lua)
// ============================================================================

// Thunar: плавающий 1280x720, полупрозрачный, без тени.
// Диалоги («Confirm to replace files», «Rename», «File Operation Progress»,
// «Properties») наследуют плавающий режим и прозрачность.
window-rule {
  match app-id=r#"^thunar$"#
  open-floating true
  default-column-width { fixed 1280; }
  default-window-height { fixed 720; }
  opacity 0.93
  shadow {
    off
  }
}

// Kitty: терминал по умолчанию шире
window-rule {
  match app-id=r#"^kitty$"#
  default-column-width { proportion 0.8; }
}

// Плавающий терминал (Mod+Shift+Return)
window-rule {
  match app-id=r#"^floatterm$"#
  open-floating true
  default-column-width { fixed 1280; }
  default-window-height { fixed 720; }
}

// Dropdown-терминал (F12) — Hyprland: float 2048x720 сверху, border 0
window-rule {
  match app-id=r#"^dropdown-kitty$"#
  open-on-workspace "dropdown"
  open-floating true
  default-floating-position x=0 y=0 relative-to="top"
  default-column-width { proportion 0.8; }
  default-window-height { proportion 0.5; }
  border {
    off
  }
}

// MPV: плавающий, без рамки
window-rule {
  match app-id=r#"^mpv$"#
  open-floating true
  border {
    off
  }
  default-column-width { fixed 1280; }
  default-window-height { fixed 720; }
}

// Swayimg: плавающий, без рамки/тени, фон сквозь окно (xray)
window-rule {
  match app-id=r#"^swayimg$"#
  open-floating true
  default-column-width { fixed 1280; }
  default-window-height { fixed 720; }
  border {
    off
  }
  shadow {
    off
  }
  background-effect {
    xray true
    blur false
    noise 0.05
    saturation 3
  }
}

// Настройки Noctalia (title «Настройки Noctalia»)
window-rule {
  match app-id=r#"^dev\.noctalia\.Noctalia$"# title=r#"^Настройки Noctalia$"#
  open-floating true
  default-column-width { fixed 1280; }
  default-window-height { fixed 1100; }
}

// Zen: браузер — рабочий стол 2, максимизирован
window-rule {
  match app-id=r#"^zen$"#
  open-on-workspace "2"
  open-maximized true
}

// Окна расширений Zen — плавающие (Hyprland: title "^Extension:*$")
window-rule {
  match app-id=r#"^zen$"# title=r#"^Extension:"#
  open-floating true
  default-column-width { fixed 450; }
  default-window-height { fixed 615; }
}

// Ayugram — рабочий стол 3, максимизирован
window-rule {
  match app-id=r#"ayugram"#
  open-on-workspace "3"
  open-maximized true
}

// LibreWolf: без тени
window-rule {
  match app-id=r#"^librewolf$"#
  shadow {
    off
  }
}

// nwg-look
window-rule {
  match app-id=r#"^nwg-look$"#
  open-floating true
  default-column-width { fixed 714; }
  default-window-height { fixed 473; }
}

// Файловые диалоги GIMP (class "file-*")
window-rule {
  match app-id=r#"^file-"#
  open-floating true
}

// Satty
window-rule {
  match app-id=r#"^com\.gabm\.satty$"#
  open-floating true
}

// YandexMusicMod — рабочий стол 5, полупрозрачный
window-rule {
  match app-id=r#"^YandexMusicMod$"#
  open-on-workspace "5"
  default-column-width { fixed 1440; }
  default-window-height { fixed 900; }
  opacity 0.8
}

// qBittorrent
window-rule {
  match app-id=r#"^org\.qbittorrent\.qBittorrent$"#
  open-floating true
}

// Ark
window-rule {
  match app-id=r#"^org\.kde\.ark$"#
  open-floating true
}

// xdg-desktop-portal-gtk
window-rule {
  match app-id=r#"^xdg-desktop-portal-gtk$"#
  open-floating true
  default-column-width { fixed 720; }
  default-window-height { fixed 500; }
}

// Dolphin
window-rule {
  match app-id=r#"^org\.kde\.dolphin$"#
  open-floating true
  default-column-width { fixed 1280; }
  default-window-height { fixed 800; }
}

// PortProton — рабочий стол 6, плавающий
window-rule {
  match app-id=r#"^PortProton$"#
  open-on-workspace "6"
  open-floating true
}

// Windows-процессы PortProton (*.exe) — рабочий стол 6, без рамки
window-rule {
  match app-id=r#"(?i).*\.exe$"#
  open-on-workspace "6"
  border {
    off
  }
}

// Waydroid
window-rule {
  match app-id=r#"^Waydroid$"#
  open-floating true
  default-column-width { fixed 1280; }
  default-window-height { fixed 720; }
}

// Timeshift
window-rule {
  match app-id=r#"^timeshift-gtk$"#
  open-floating true
}

// Бордер/кольцо рисуем вокруг окна, без фоновой подложки
window-rule {
  draw-border-with-background false
}

// ============================================================================
// Горячие клавиши (conf/keybinds.lua)
// ============================================================================

binds {
  Mod+Shift+Slash { show-hotkey-overlay; }

  // ---- Noctalia (shell = 'noctalia msg ') ---------------------------
  Mod+Shift+P hotkey-overlay-title="Noctalia Settings" { spawn-sh "noctalia msg settings-toggle"; }
  Mod+X         hotkey-overlay-title="Session Panel"   { spawn-sh "noctalia msg panel-toggle session"; }
  Mod+Shift+W   hotkey-overlay-title="Wallpaper Panel" { spawn-sh "noctalia msg panel-toggle wallpaper"; }
  Mod+R         hotkey-overlay-title="Launcher"        { spawn-sh "noctalia msg panel-toggle launcher"; }
  Mod+Shift+V   hotkey-overlay-title="Clipboard"       { spawn-sh "noctalia msg panel-toggle clipboard"; }

  // ---- Скрипты -------------------------------------------------------
  Mod+Period  hotkey-overlay-title="Menu with symbols" { spawn-sh "sh $HOME/.bin/symbolMenu"; }
  Alt+Shift+H { spawn-sh "noctalia msg bar-toggle"; }
  // Alt+Shift+Delete убран: ~/.bin/toggleTouchpad правит hyprland input.lua
  // (не работает под niri — niri пока не умеет отключать устройства по отдельности).

  // ---- Программы ------------------------------------------------------
  Mod+Return hotkey-overlay-title="Open a Terminal: kitty" { spawn "kitty"; }
  Mod+Shift+Return hotkey-overlay-title="Floating Terminal" { spawn "kitty" "--class" "floatterm"; }
  Mod+E       hotkey-overlay-title="Open file manager: Thunar" { spawn "thunar"; }
  Mod+Shift+Z hotkey-overlay-title="Run a browser: Zen" { spawn "zen-browser"; }
  Mod+Shift+L hotkey-overlay-title="LibreWolf" { spawn "librewolf"; }
  Mod+T       hotkey-overlay-title="Open telegram client: Ayugram" { spawn "AyuGram"; }

  // ---- Управление окнами -----------------------------------------------
  Mod+Shift+C { center-column; }
  Mod+F       { fullscreen-window; }
  Mod+M       { maximize-window-to-edges; }
  // Hyprland: Mod+P = pseudo (dwindle) — ближайший аналог в niri — флоат
  Mod+P       { toggle-window-floating; }
  Mod+V       { toggle-window-floating; }
  Mod+Q repeat=false { close-window; }

  // ---- Фокус / перемещение ------------------------------------------------
  Mod+Left  { focus-column-left; }
  Mod+Down  { focus-window-down; }
  Mod+Up    { focus-window-up; }
  Mod+Right { focus-column-right; }
  Mod+H     { focus-column-left; }
  Mod+J     { focus-window-down; }
  Mod+K     { focus-window-up; }
  Mod+L     { focus-column-right; }

  Mod+Ctrl+Left  { move-column-left; }
  Mod+Ctrl+Down  { move-window-down; }
  Mod+Ctrl+Up    { move-window-up; }
  Mod+Ctrl+Right { move-column-right; }
  Mod+Ctrl+H     { move-column-left; }
  Mod+Ctrl+J     { move-window-down; }
  Mod+Ctrl+K     { move-window-up; }
  Mod+Ctrl+L     { move-column-right; }

  // Hyprland: Mod+Shift+стрелки = ресайз окна на 30px
  Mod+Shift+Left  { set-column-width "-10%"; }
  Mod+Shift+Right { set-column-width "+10%"; }
  Mod+Shift+Up    { set-window-height "-10%"; }
  Mod+Shift+Down  { set-window-height "+10%"; }

  Mod+Home { focus-column-first; }
  Mod+End  { focus-column-last; }
  Mod+Ctrl+Home { move-column-to-first; }
  Mod+Ctrl+End  { move-column-to-last; }

  // Мониторы (пригодится при подключении внешнего монитора;
  // Mod+Shift+L занят LibreWolf)
  Mod+Shift+H { focus-monitor-left; }
  Mod+Shift+J { focus-monitor-down; }
  Mod+Shift+K { focus-monitor-up; }

  Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
  Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
  Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
  Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

  // ---- Рабочие столы --------------------------------------------------------
  Mod+Page_Down      { focus-workspace-down; }
  Mod+Page_Up        { focus-workspace-up; }
  Mod+U              { focus-workspace-down; }
  Mod+I              { focus-workspace-up; }
  Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
  Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
  Mod+Ctrl+U         { move-column-to-workspace-down; }
  Mod+Ctrl+I         { move-column-to-workspace-up; }

  Mod+Shift+Page_Down { move-workspace-down; }
  Mod+Shift+Page_Up   { move-workspace-up; }
  Mod+Shift+U         { move-workspace-down; }
  Mod+Shift+I         { move-workspace-up; }

  Mod+WheelScrollDown      { focus-column-right; }
  Mod+WheelScrollUp        { focus-column-left; }
  Mod+Shift+WheelScrollDown { move-column-right; }
  Mod+Shift+WheelScrollUp   { move-column-left; }

  Mod+1 { focus-workspace "1"; }
  Mod+2 { focus-workspace "2"; }
  Mod+3 { focus-workspace "3"; }
  Mod+4 { focus-workspace "4"; }
  Mod+5 { focus-workspace "5"; }
  Mod+6 { focus-workspace "6"; }
  Mod+Shift+1 { move-column-to-workspace "1"; }
  Mod+Shift+2 { move-column-to-workspace "2"; }
  Mod+Shift+3 { move-column-to-workspace "3"; }
  Mod+Shift+4 { move-column-to-workspace "4"; }
  Mod+Shift+5 { move-column-to-workspace "5"; }
  Mod+Shift+6 { move-column-to-workspace "6"; }

  // Dropdown-терминал (Hyprland: F12 — toggle special:dropdown)
  F12 { focus-workspace "dropdown"; }

  Mod+BracketLeft  { consume-or-expel-window-left; }
  Mod+BracketRight { consume-or-expel-window-right; }

  // Ширина колонки (в Hyprland была Mod+R — теперь там launcher Noctalia)
  Mod+D { switch-preset-column-width; }
  Mod+Shift+D { switch-preset-column-width-back; }

  Mod+Shift+F { expand-column-to-available-width; }

  Mod+C     { center-column; }
  Mod+Ctrl+C { center-visible-columns; }

  Mod+O repeat=false { toggle-overview; }

  // ---- Скриншоты --------------------------------------------------------------
  // Hyprland вызывал grim-скрипт (~/.bin/prtScrn); grim/slurp под niri не
  // работают, поэтому используем встроенный скриншот с тем же поведением.
  Print        { screenshot; }
  Ctrl+Print   { screenshot-screen; }
  Alt+Print    { screenshot-window; }
  Mod+Shift+S  { screenshot; }

  // ---- Медиа / яркость (через Noctalia, как в Hyprland) ----------------------
  XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up 5"; }
  XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down 5"; }
  XF86AudioMute        allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
  XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_SOURCE@ toggle"; }

  XF86AudioNext  allow-when-locked=true { spawn-sh "noctalia msg media next"; }
  XF86AudioPrev  allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
  XF86AudioPlay  allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
  XF86AudioPause allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }

  XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "noctalia msg brightness-up 5"; }
  XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down 5"; }

  // ---- Система -----------------------------------------------------------------
  Super+Alt+S allow-when-locked=true hotkey-overlay-title=null { spawn-sh "pkill orca || exec orca"; }

  Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

  Mod+Shift+E { quit; }
  Ctrl+Alt+Delete { quit; }

  // Раньше Mod+Shift+P был power-off-monitors — теперь его занимает
  // «Noctalia Settings». При желании вернуть на другой бинд:
  // Mod+Shift+O { power-off-monitors; }
}

// Перетаскивание окна: Mod + ЛКМ, ресайз: Mod + ПКМ — встроено в niri.
