# --- Подключение и пути ---
mpd_host = "127.0.0.1"
mpd_port = "6600"
mpd_music_dir = "~/Music"
mpd_connection_timeout = 5

# --- Визуализатор спектра (клавиша '8') ---
visualizer_data_source = "/tmp/mpd.fifo"
visualizer_output_name = "fifo output"
visualizer_in_stereo = "yes"
visualizer_type = "spectrum"
visualizer_color = "magenta, blue, cyan"
visualizer_look = "●▮"
visualizer_fps = 60
visualizer_autoscale = "yes"

# --- Настройки интерфейса ---
user_interface = "alternative"
header_visibility = "yes"
statusbar_visibility = "yes"
titles_visibility = "yes"
enable_window_title = "yes"
song_window_title_format = "{%a - %t}"
display_bitrate = "yes"
display_volume_level = "yes"
clock_display_seconds = "yes"

# --- Режимы отображения ---
playlist_display_mode = "columns"
browser_display_mode = "columns"
progressbar_look = "───"

# --- Колонки (без каши из всех цветов радуги) ---
song_columns_list_format = "(30)[magenta]{a} (40)[default]{t} (22)[blue]{b} $R(8)[cyan]{l}"

# --- Поведение и навигация ---
autocenter_mode = "yes"
cyclic_scrolling = "yes"
incremental_seeking = "yes"
ignore_leading_the = "no"
playlist_disable_highlight_delay = "-1"
allow_for_physical_item_deletion = "yes"
message_delay_time = 8
follow_now_playing_lyrics = "yes"
external_editor = "nvim"
ask_before_clearing_playlists = "no"

# --- Чистые цвета ---
colors_enabled = "yes"
empty_tag_color = "blue"
header_window_color = "default"
state_line_color = "cyan"
state_flags_color = "magenta"
main_window_color = "default"
color1 = "white"
color2 = "magenta"
progressbar_color = "black"
progressbar_elapsed_color = "magenta"
statusbar_color = "default"
window_border_color = "blue"
active_window_border = "magenta"

# --- Адекватное выделение (БЕЗ инверсии фона) ---
# Наведенная строка будет просто выделена жирным шрифтом со стрелочкой
current_item_prefix = "$(cyan)$b> "
current_item_suffix = "$/b$(end)"

current_item_inactive_column_prefix = "$(blue)"
current_item_inactive_column_suffix = "$(end)"

# Трек, который играет прямо сейчас
now_playing_prefix = "$(magenta)$b▶ "
now_playing_suffix = "$/b$(end)"

# Выбранные треки (multi-selection)
selected_item_prefix = "$(yellow)+ "
selected_item_suffix = "$(end)"
