{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
      "type": "kitty",
      "source": "~/.bin/ico/teto.png",
      // "width": 28,
      "height": 16,
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2,
      "bottom": 0
    }
  },
  "display": {
    "separator": " ➔  ",
    "color": {
      "keys": "magenta",
      "title": "blue"
    },
    "key": {
      "width": 17
    }
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "┌────────────────────────────────────────────────────┐"
    },
    {
      "type": "os",
      "key": " 󰣇 OS",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": " 󰌽 Kernel",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": " 󱎫 Uptime",
      "keyColor": "green"
    },
    {
      "type": "command",
      "key": " 󰚢 Lifetime",
      "keyColor": "cyan",
      "text": "birth=$(stat -c %W /); current=$(date +%s); echo \"$(( (current - birth) / 86400 )) days\""
    },
    {
      "type": "localip",
      "key": " 󰩟 Local IP",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": " 󰏖 Packages",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": " 󱆃 Shell",
      "keyColor": "blue"
    },
    {
      "type": "display",
      "key": " 󰍹 Display",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": " 󱂬 WM",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": " 󰆍 Terminal",
      "keyColor": "yellow"
    },
    {
      "type": "cpu",
      "key": " 󰻠 CPU",
      "keyColor": "magenta"
    },
    {
      "type": "gpu",
      "key": " 󰢮 GPU",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": " 󰑭 Memory",
      "keyColor": "cyan"
    },
    {
      "type": "disk",
      "key": " 󰋊 Disk",
      "keyColor": "green"
    },
/*    {
      "type": "colors",
      "symbol": "circle"
    },*/
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────────┘"
    }
  ]
}
