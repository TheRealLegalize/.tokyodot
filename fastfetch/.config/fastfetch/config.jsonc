{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    
    "logo": {
        "type": "kitty",
        "source": "~/.bin/ico/goth.png",
        "height": 20,
//        "width": 44,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },

    "display": {
        "separator": " ❯ ",
        "color": {
            "keys": "magenta",
            "title": "magenta"
        },
        "percent": {
            "type": 3, // Текст + индикатор
            "color": {
                "green": "32",
                "yellow": "33",
                "red": "31"
            }
        },
        "bar": {
            "char": {
                "elapsed": "", // Заполненная часть аккуратной точкой
                "total": ""   // Пустая часть тонкой линией
            },
            "width": 10
        }
    },

    "modules": [
        // Title
        {
            "type": "title",
            "format": "{user-name-colored}@{host-name-colored}"
        },
        {
            "type": "custom",
            "format": "───────────────────────────────────────"
        },

        // System Core
        {
            "type": "os",
            "key": " 󰍹 OS       ",
            "keyColor": "bright_magenta"
        },
        {
            "type": "kernel",
            "key": " 󰌽 Kernel   ",
            "keyColor": "bright_magenta"
        },
        {
            "type": "uptime",
            "key": " 󰅐 Uptime   ",
            "keyColor": "bright_magenta"
        },
        {
            "type": "command",
            "key": " 󰃭 Age      ",
            "keyColor": "bright_magenta",
            "text": "birth=$(stat -c %W / 2>/dev/null || stat -c %Y /); now=$(date +%s); echo \"$(( (now - birth) / 86400 )) days\""
        },
        {
            "type": "packages",
            "key": " 󰏖 Packages ",
            "keyColor": "bright_magenta"
        },

        // Environment
        {
            "type": "custom",
            "format": "───────────────────────────────────────"
        },
        {
            "type": "de",
            "key": " 󰧨 DE       ",
            "keyColor": "bright_cyan"
        },
        {
            "type": "wm",
            "key": "  WM       ",
            "keyColor": "bright_cyan"
        },
        {
            "type": "theme",
            "key": " 󰉼 Theme    ",
            "keyColor": "bright_cyan"
        },
        {
            "type": "icons",
            "key": " 󰀻 Icons    ",
            "keyColor": "bright_cyan"
        },
        {
            "type": "terminal",
            "key": "  Terminal ",
            "keyColor": "bright_cyan"
        },
        {
            "type": "shell",
            "key": " 󰞷 Shell    ",
            "keyColor": "bright_cyan"
        },

        // Hardware & Resources
        {
            "type": "custom",
            "format": "───────────────────────────────────────"
        },
        {
            "type": "cpu",
            "key": "  CPU      ",
            "keyColor": "bright_yellow",
            "showPeCoreCount": false,
            "temp": false
        },
        {
            "type": "gpu",
            "key": " 󰢮 GPU      ",
            "keyColor": "bright_yellow"
        },
        {
            "type": "memory",
            "key": " 󰍛 RAM      ",
            "keyColor": "bright_green"
        },
        {
            "type": "swap",
            "key": " 󰓡 SWAP     ",
            "keyColor": "bright_green"
        },
        {
            "type": "disk",
            "key": " 󰋊 Disk (/) ",
            "keyColor": "bright_blue",
            "folders": "/"
        },
        {
            "type": "localip",
            "key": " 󰩟 Local IP ",
            "keyColor": "bright_blue",
            "showIpv6": false
        },

        // Palette
        {
            "type": "custom",
            "format": "───────────────────────────────────────"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
