{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    
    "logo": {
        "type": "kitty",
        "source": "~/.bin/ico/goth.png",
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },

    "display": {
        "separator": " ❯ ",
        "color": {
            "keys": "magenta",
            "title": "magenta"
        },
        "percent": {
            "type": 3, // Текст + индикатор
            "color": {
                "green": "32",
                "yellow": "33",
                "red": "31"
            }
        },
        "bar": {
            "char": {
                "elapsed": "", // Заполненная часть аккуратной точкой
                "total": ""   // Пустая часть тонкой линией
            },
            "width": 10
        }
    },

    "modules": [
        // Title
        {
            "type": "title",
            "format": "{user-name-colored}@{host-name-colored}"
        },
        {
            "type": "custom",
            "format": "───────────────────────────────────────"
        },

        // System Core
        {
            "type": "os",
            "key": " 󰍹 OS       ",
            "keyColor": "bright_magenta"
        },
        {
            "type": "kernel",
            "key": " 󰌽 Kernel   ",
            "keyColor": "bright_magenta"
        },
        {
            "type": "uptime",
            "key": " 󰅐 Uptime   ",
            "keyColor": "bright_magenta"
        },
        {
            "type": "command",
            "key": " 󰃭 Age      ",
            "keyColor": "bright_magenta",
            "text": "birth=$(stat -c %W / 2>/dev/null || stat -c %Y /); now=$(date +%s); echo \"$(( (now - birth) / 86400 )) days\""
        },
        {
            "type": "packages",
            "key": " 󰏖 Packages ",
            "keyColor": "bright_magenta",
            "disabled": ["flatpak"], // Плоские пакеты не считаем
            "format": "{all}" // Только число, без имени пакетного менеджера
        },

        // Environment
        {
            "type": "custom",
            "format": "───────────────────────────────────────"
        },
        {
            "type": "de",
            "key": " 󰧨 DE       ",
            "keyColor": "bright_cyan"
        },
        {
            "type": "wm",
            "key": "  WM       ",
            "keyColor": "bright_cyan"
        },
        {
            "type": "theme",
            "key": " 󰉼 Theme    ",
            "keyColor": "bright_cyan",
            "format": "{theme2}" // Только GTK-тема, без Qt
        },
        {
            "type": "icons",
            "key": " 󰀻 Icons    ",
            "keyColor": "bright_cyan"
        },
        {
            "type": "terminal",
            "key": "  Terminal ",
            "keyColor": "bright_cyan"
        },
        {
            "type": "shell",
            "key": " 󰞷 Shell    ",
            "keyColor": "bright_cyan"
        },

        // Hardware & Resources
        {
            "type": "custom",
            "format": "───────────────────────────────────────"
        },
        {
            // Компактно: только модель (i5-1155G7), плюс ядра и частота
            "type": "command",
            "key": "  CPU      ",
            "keyColor": "bright_yellow",
            "text": "out=$(fastfetch --logo none --structure cpu 2>/dev/null | sed -E 's/^[^[:alnum:]]*CPU[^[:alnum:]]*//; s/ [0-9]+-Core Processor//; s/ CPU @ [0-9.]+GHz//; s/^.*[^[:alnum:]](i[3579]-[0-9]{3,5}[A-Za-z0-9]*|EPYC [0-9]{3,4}[A-Za-z0-9-]*|Ryzen Threadripper [0-9]{4}[A-Za-z0-9]*|Ryzen [3579] [0-9]{4}[A-Za-z0-9]*|M[1-9]( (Pro|Max|Ultra))?|Xeon[(]R[)] (Platinum |Gold |Silver |Bronze )?[0-9]+[A-Za-z0-9-]*)/\\1/'); [ -n \"$out\" ] || out=$(sed -n 's/^model name[[:space:]]*:[[:space:]]*//p' /proc/cpuinfo | head -n1); printf '%s\\n' \"$out\""
        },
        {
            "type": "gpu",
            "key": " 󰢮 GPU      ",
            "keyColor": "bright_yellow",
            "format": "{vendor} {name}"
        },
        {
            "type": "memory",
            "key": " 󰍛 RAM      ",
            "keyColor": "bright_green",
            "format": "{percentage-bar} {percentage}"
        },
        {
            "type": "swap",
            "key": " 󰓡 SWAP     ",
            "keyColor": "bright_green",
            "format": "{percentage-bar} {percentage}"
        },
        {
            "type": "localip",
            "key": " 󰩟 Local IP ",
            "keyColor": "bright_blue",
            "showIpv6": false
        },

        // Palette
        {
            "type": "custom",
            "format": "───────────────────────────────────────"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
