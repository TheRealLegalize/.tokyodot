#!/bin/bash

DIR="$HOME/Screenshots"
mkdir -p "$DIR"
FILE="$DIR/$(date +%Y-%m-%d_%H-%M-%S).jpg"

SLURP_ARGS=(-b '#00000088' -c '#89b4fa' -s '#89b4fa22' -w 2)

if [[ "$1" = "-f" ]]; then
  grim "$FILE"
else
  GEOM=$(slurp "${SLURP_ARGS[@]}")
  
  [[ -z "$GEOM" ]] && exit 0

  if [[ "$1" = "-s" ]]; then
    grim -g "$GEOM" -t ppm - | satty --filename - 2>/dev/null
    exit 0
  else
    grim -g "$GEOM" "$FILE"
    notify-send --app-name='Screenshot' --icon='image' 'Screenshot copied to clipboard'
  fi
fi

wl-copy < "$FILE"
