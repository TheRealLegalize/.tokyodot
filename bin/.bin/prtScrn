#!/bin/bash

DIR="$HOME/Screenshots"
mkdir -p "$DIR"
FILE="$DIR/$(date +%Y-%m-%d_%H-%M-%S).jpg"

if [[ "$1" = "-f" ]]; then
  grim "$FILE"
elif [[ "$1" = "-s" ]]; then
  grim -g "$(slurp -b '#00000088' -c '#89b4fa' -s '#89b4fa22' -w 2; sleep 0.18)" -t ppm - | satty --filename - 2>/dev/null
  exit
else
  grim -g "$(slurp -b '#00000088' -c '#89b4fa' -s '#89b4fa22' -w 2; sleep 0.18)" "$FILE"
fi
wl-copy < "$FILE"
