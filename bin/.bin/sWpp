#!/bin/bash

dir="$HOME/Wallpapers/"
if [[ ! -d "$dir" ]]; then
  echo "Ошибка: директория '$dir' не существует"
  exit 1
fi


fzf_args=(
  --multi
  --preview "magick $HOME/Wallpapers/{} -resize 800x600 - | kitten icat --align left --clear --transfer-mode stream"
  --preview-window 'up:60%:wrap'
  --color='spinner:#f5e0dc,hl:#f089b6'
  --color='fg:#f2f4f8,header:#f089b6,info:#76d191,pointer:#f5e0dc'
  --color='marker:#b2b5ff,fg+:#f2f4f8,prompt:#76d191,hl+:#f089b6'
  --color='selected-bg:#393939' \
  --color='border:#6f6f6f,label:#f2f4f8'
  --layout reverse
  --cycle
)

eza -G1 -s Name --icons=never "$dir" | fzf "${fzf_args[@]}"
