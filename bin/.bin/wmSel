#!/bin/bash

# Тотальное истребление синего цвета
cat << EOF > /tmp/.dialogrc_blue
use_shadow = ON

# Общий фон (был голубой, стал черный)
screen_color = (WHITE,BLACK,OFF)

# Окно (черный текст на серовато-белом фоне)
dialog_color = (BLACK,WHITE,OFF)
title_color = (BLUE,WHITE,ON)
border_color = (BLUE,WHITE,ON)

# Кнопки
button_active_color = (WHITE,BLUE,ON)
button_inactive_color = (BLACK,WHITE,OFF)
button_key_active_color = (WHITE,BLUE,ON)
button_key_inactive_color = (BLUE,WHITE,OFF)
button_label_active_color = (WHITE,BLUE,ON)
button_label_inactive_color = (BLACK,WHITE,OFF)

# Меню и списки
item_color = (BLACK,WHITE,OFF)
item_selected_color = (WHITE,BLUE,ON)

# Те самые цифры (теги) и их ключи
tag_color = (BLUE,WHITE,ON)
tag_selected_color = (WHITE,BLUE,ON)
tag_key_color = (BLUE,WHITE,ON)
tag_key_selected_color = (WHITE,BLUE,ON)

# Индикаторы и прочее
check_color = (BLACK,WHITE,OFF)
check_selected_color = (WHITE,BLUE,ON)
uarrow_color = (BLUE,WHITE,ON)
darrow_color = (BLUE,WHITE,ON)

# Тень
shadow_color = (WHITE,BLACK,ON)
EOF

export DIALOGRC=/tmp/.dialogrc_blue

selection=$(dialog --stdout \
    --title " WM Selector " \
    --menu "Select what WM to star:" 10 45 2 \
    "1" "Hyprland" \
    "2" "Niri" \
    "3" "Exit to tty")

rm -f /tmp/.dialogrc_blue

case $selection in
    1) start-hyprland ;;
    2) niri ;;
    3) exit ;;
    *) exit ;;
esac
