#!/bin/bash
# ~/.bin/sFloat — правильная версия для Hyprland 0.55 Lua

geom=$(slurp -d -b 15151540 -c d1d7e8ff -w 2 -f "%x %y %w %h" 2>/dev/null) || exit 1

read -r x y w h <<< "$geom"

if [ -z "$x" ] || [ -z "$w" ]; then
    exit 1
fi

# Правильный способ для Lua-конфига
exec hyprctl dispatch exec "float size $w $h move $x $y $1"
